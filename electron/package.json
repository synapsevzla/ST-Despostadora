{
  "name": "st-despostadora",
  "version": "1.0.0",
  "description": "Sistema de Control Operativo de Desposte y Rendimiento Cárnico",
  "main": "main.js",
  "author": "Soluciones Totales",
  "homepage": "https://solucionestotales.com",
  "license": "Proprietary",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --config.directories.output=../dist_windows",
    "build:linux": "electron-builder --linux deb --config.directories.output=../dist_linux"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.solucionestotales.despostadora",
    "productName": "ST Despostadora",
    "files": [
      "main.js",
      "preload.js",
      "portFinder.js",
      "phpManager.js",
      "configManager.js",
      "wizard/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist_web",
        "to": "dist_web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "php-win",
          "to": "php-win",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "Soluciones Totales <soporte@solucionestotales.com>",
      "synopsis": "Sistema de Control Operativo de Desposte y Rendimiento Cárnico",
      "description": "Sistema de pesajes, control y rendimiento cárnico conectado a Microsoft SQL Server."
    },
    "deb": {
      "depends": [
        "php-cli (>= 8.1) | php (>= 8.1)",
        "libnotify4",
        "libxtst6",
        "libnss3"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ST Despostadora",
      "uninstallDisplayName": "ST Despostadora",
      "deleteAppDataOnUninstall": false
    }
  }
}
